---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, getProjects, postUrl } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { project: project.id }, props: { project } }));
}
const { project } = Astro.props;
const posts = await getPosts(project.id);
const { Content } = await render(project);
---
<Base title={project.data.name} description={project.data.tagline} nav="projects">
  <p class="eyebrow">Project · {project.data.status}</p>
  <h1>{project.data.name}</h1>
  <p class="lead">{project.data.tagline}</p>
  <div class="prose"><Content /></div>
  <ul class="stack">{project.data.stack.map((s) => <li>{s}</li>)}</ul>
  {project.data.repo && <p><a href={project.data.repo}>Source on GitHub →</a></p>}

  <h2 class="section-title">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <div>
          <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
          <p>{post.data.summary}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
